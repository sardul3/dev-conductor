{
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python3 ~/.claude/hooks/prompt-enrich/classify.py"
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "bash ~/.claude/hooks/prompt-enrich/ensure_prompt_log_proxy.sh"
        }
      ]
    }
  ]
}
