# ~/.config/dev-conductor/dev-loop/config.yaml
# All knobs live here. Secrets stay in ~/.config/dev-conductor/secrets.env.

mode: prod
dev_root: ~/dev

repo:
  # If non-empty, only these folder names may run /dev-loop (SessionStart still prints keys at ~/dev).
  allowlist: []
  denylist: []
  # Picker when cwd is not a git repo: scan ~/dev this many levels deep.
  max_depth: 3
  max_choices: 40
  ask_when_cwd_not_repo: true
  create_private: true
  gh_create: true

jira:
  project: ASE
  jql: 'assignee = currentUser() AND sprint in openSprints() AND statusCategory != Done'
  # Override secrets ATLASSIAN_BASE_URL when set.
  base_url: ''
  auth: basic
  search_path: /rest/api/3/search/jql
  issue_path: /rest/api/3/issue/{key}
  fields: summary,description,status,issuetype,comment,labels
  max_keys: 15
  timeout_sec: 20
  comment_limit: 8

git:
  require_github_remote: true
  allow_outside_dev: false
  never_commit_branches:
    - main
    - master
  branch_pattern: 'feat/{key}-{slug}'
  commit_type: feat
  slug_max_len: 40
  push: true
  create_pr: true
  gh_bin: gh
  pr_title_pattern: '{type}: {summary} ({key})'
  # PR body is generated (Jira browse link, inferred recipe commands, verify.log
  # evidence). No spec excerpt. Not a yaml template.
  merge_to_default_after_ship: false
  check_conventional: true
  rewrite_unpushed: true
  stack_prs: false
  max_files_per_pr: 0
  merge_method: squash
  # worktree = native `git worktree` under {repo}-worktrees/{KEY} (default; visible).
  # treehouse = leased worktree via `treehouse get --lease`.
  # none = work in the clone you passed to start. Eval uses none.
  isolation: worktree
  treehouse_bin: treehouse
  treehouse_return_on_ship: true
  treehouse_lease_holder: dev-loop

# Concurrent in-progress tickets (run dirs that are not yet shipped). Extra starts exit.
queue:
  max_active: 3

runtime:
  # claude = launch-clean-claude.sh then wait; cursor = one-stage `cli.py step` (never polls);
  # none = no terminals (eval / builtin adapters).
  agent: claude
  launch_script: ~/.claude/hooks/prompt-enrich/launch-clean-claude.sh
  wait_timeout_sec: 86400
  poll_interval_sec: 2
  no_launch: false
  builtin_adapters: false
  auto_continue: false

caps:
  writer_retries: 3
  review_retries: 3
  # 0 = off. Overnight / long unattended: set these so a runaway cannot eat the weekly quota.
  # Worst-case spend is about max_launches × max_budget_usd (each Claude session gets --max-budget-usd).
  max_launches: 0
  max_tokens: 0
  max_budget_usd: 0
  wall_sec: 0
  # overnight example:
  # max_launches: 12
  # max_tokens: 400000
  # max_budget_usd: 2
  # wall_sec: 28800

review:
  pass_verdicts:
    - excellent
    - good
  rewrite_verdicts:
    - good-with-risks
    - needs_improvement
    - blocker
  default_verdict: good

stages:
  spec:
    enabled: true
    auto_approve: false
  test_writer:
    enabled: true
  writer:
    enabled: true
  verify:
    enabled: true
  review:
    enabled: true
  simplify:
    enabled: false
  ship:
    enabled: true

session_start:
  enabled: true
  cache_minutes: 10
  keys_limit: 15
  print_keys: true

memory:
  max_contract_files: 24
  max_contract_lines: 80


# Apply verdict.metadata[] into AGENTS.md / path-scoped rules after review.
agent_memory:
  auto_apply: true
health: {}
verify: {}
verify_fail_closed: true
verify_timeout_sec: 1800


# --- v2 gates (off until you opt in) ---
# PIT "survived" is mutants that were NOT killed (bad). Prefer metric: killed, min_pct: 75.
# Do not set min_pct: 98 with metric: survived unless you really want almost no killing.

quality:
  snyk:
    enabled: false
    required: false
    cmd: snyk test --json
    fail_on: high
  sonar:
    enabled: false
    required: false
    cmd: sonar-scanner
  mutation:
    enabled: false
    required: false
    cmd: ''
    metric: killed
    min_pct: 75

evidence:
  enabled: false
  mode: http
  timeout_sec: 8
  playwright_cmd: ''
  probes: []
  # Ship refuses without an image/video in runs/KEY/evidence/ (all tickets).
  # Eval (config.test.yaml) sets this false. Agent captures; CLI cannot screenshot.
  require_visual: true
  # probes:
  #   - method: GET
  #     url: http://127.0.0.1:8080/actuator/health

# auto = on only for UI repos (React/Vue/shadcn/…). Force with on/off. Per-slug override in repos.
lavish:
  enabled: auto
  repos: {}
  # repos:
  #   payments-api: off
  #   design-system: on

# Arch Studio: optional architecture pack between spec grill and spec approve.
# auto = on when the Jira ticket or repo looks like integration / architecture work.
arch_studio:
  enabled: auto
  require_review: true
  repos: {}
  # repos:
  #   payments-api: on
  #   tiny-cli: off

poller:
  enabled: false
  interval_minutes: 30
  auto_merge: false
  on_comments: fix
  on_checks_failed: fix
  notify: true
  merge_method: squash
  bot_logins: []

workflow:
  # start/step/ship fire these. false only for eval (config.test.yaml).
  enabled: true
  on_start: In Progress
  on_pr: In Review
  on_merge: Done
  on_block: Blocked
  on_waiting: Waiting
  deploy_ticket_jql: ''
  deploy_ticket_key: ''
  comment_on_progress: true
  # Assign the authenticated Atlassian user on start when unassigned (skip if someone else).
  assign_on_start: true
  # {number} {branch} {pr_url}/{url}. HTTPS URL is appended if the template omits it.
  on_pr_comment: |
    PR #{number} opened on {branch}
    {pr_url}

# supervised = grill spec then wait. unattended = auto-approve spec and run through PR with no operator.
# Still launches agent sessions; they must finish on their own. merge: auto turns on poller.auto_merge.
autonomy:
  profile: supervised
  spec_approval: human
  continue_after_spec: false
  merge: alert
  ask_repo: true
