n&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;shadow=0;align=left;verticalAlign=top;spacing=8;fillColor=#F4F3FF;strokeColor=#7A5AF8;strokeWidth=1.5;fontColor=#101828;fontSize=11;" parent="1" vertex="1" arch-id="ui-screen-order-entry.ui-region-summary" arch-kind="ui-region"><mxGeometry as="geometry" x="74.8" y="232.2" width="369" height="656" /></mxCell><mxCell id="ui-order-entry-wide-view-ui-region-ui-region-form" value="&lt;b&gt;Order review form&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;Order review form · main&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#475467&quot;&gt;Editable delivery details, validation summary, terms acknowledgement, and the primary submit action.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#175CD3&quot;&gt;Actions: Submit order&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#B54708&quot;&gt;Bindings: ui-binding-submit-order&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;shadow=0;align=left;verticalAlign=top;spacing=8;fillColor=#EFF8FF;strokeColor=#2E90FA;strokeWidth=1.5;fontColor=#101828;fontSize=11;" parent="1" vertex="1" arch-id="ui-screen-order-entry.ui-region-form" arch-kind="ui-region"><mxGeometry as="geometry" x="468.4" y="232.2" width="852.8" height="492" /></mxCell><mxCell id="ui-order-entry-wide-view-ui-region-ui-region-status" value="&lt;b&gt;Submission status&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;Order status panel · status&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#475467&quot;&gt;Loading, error, offline, or confirmation content with owned recovery actions and live announcements.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#175CD3&quot;&gt;Actions: Retry submission&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#B54708&quot;&gt;Bindings: ui-binding-submit-order&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;shadow=0;align=left;verticalAlign=top;spacing=8;fillColor=#ECFDF3;strokeColor=#12B76A;strokeWidth=1.5;fontColor=#101828;fontSize=11;" parent="1" vertex="1" arch-id="ui-screen-order-entry.ui-region-status" arch-kind="ui-region"><mxGeometry as="geometry" x="468.4" y="748.8" width="852.8" height="139.4" /></mxCell><mxCell id="ui-order-entry-wide-view-ui-state" value="&lt;b&gt;Rendered state · Ready to review&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;default · trigger: Order data and authorization are available&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#475467&quot;&gt;Review order details and submit when the summary is correct.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#175CD3&quot;&gt;Focus: Page heading on initial navigation; preserve current focus after inline edits · Announces: Order review loaded&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFAEB;strokeColor=#F79009;fontColor=#7A2E0E;fontSize=10;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1" arch-id="ui-screen-order-entry.ui-state-default" arch-kind="ui-state"><mxGeometry as="geometry" x="1460" y="108" width="310" height="128" /></mxCell><mxCell id="ui-order-entry-wide-view-legend-box" value="&lt;b&gt;Legend&lt;/b&gt;" style="swimlane;html=1;rounded=1;horizontal=1;startSize=28;collapsible=0;container=0;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#98A2B3;fontColor=#344054;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" parent="1" vertex="1" arch-id="ui-order-entry-wide-view-legend" arch-kind="legend"><mxGeometry as="geometry" x="1460" y="800" width="310" height="140" /></mxCell><mxCell id="ui-order-entry-wide-view-legend-item-0" value="&lt;b&gt;Blue region&lt;/b&gt; &lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;— Primary content or data-bound surface&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#344054;fontSize=9;spacingLeft=20;indicatorColor=#2E90FA;indicatorShape=rect;" parent="1" vertex="1"><mxGeometry as="geometry" x="1468" y="831" width="294" height="23" /></mxCell><mxCell id="ui-order-entry-wide-view-legend-item-1" value="&lt;b&gt;Green region&lt;/b&gt; &lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;— Interactive action surface&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#344054;fontSize=9;spacingLeft=20;indicatorColor=#12B76A;indicatorShape=rect;" parent="1" vertex="1"><mxGeometry as="geometry" x="1468" y="856" width="294" height="23" /></mxCell><mxCell id="ui-order-entry-wide-view-legend-item-2" value="&lt;b&gt;Purple region&lt;/b&gt; &lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;— Navigation or supporting landmark&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#344054;fontSize=9;spacingLeft=20;indicatorColor=#7A5AF8;indicatorShape=rect;" parent="1" vertex="1"><mxGeometry as="geometry" x="1468" y="881" width="294" height="23" /></mxCell><mxCell id="ui-order-entry-wide-view-legend-item-3" value="&lt;b&gt;State note&lt;/b&gt; &lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;— Rendered state, focus, and announcement&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#344054;fontSize=9;spacingLeft=20;indicatorColor=#F79009;indicatorShape=rect;" parent="1" vertex="1"><mxGeometry as="geometry" x="1468" y="906" width="294" height="23" /></mxCell></root></mxGraphModel></diagram><diagram id="73f0cd51e9a6" name="Order entry screen-state contract"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ui-order-entry-state-map-title" value="&lt;b&gt;Order entry screen-state contract&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=20;fontColor=#101828;fontStyle=1;" parent="1" vertex="1" arch-id="ui-order-entry-state-map" arch-kind="view-title"><mxGeometry as="geometry" x="24" y="16" width="1552" height="34" /></mxCell><mxCell id="ui-order-entry-state-map-purpose" value="Review triggers, content, available actions, focus targets, and announcements for all critical states." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#475467;" parent="1" vertex="1"><mxGeometry as="geometry" x="24" y="50" width="1552" height="28" /></mxCell><mxCell id="ui-order-entry-state-map-state-ui-state-default" value="&lt;b&gt;Ready to review&lt;/b&gt; &lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;(default)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#475467&quot;&gt;Trigger: Order data and authorization are available&lt;/span&gt;&lt;br&gt;Review order details and submit when the summary is correct.&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#175CD3&quot;&gt;Actions: ui-action-submit-order, ui-action-orders&lt;br&gt;Focus: Page heading on initial navigation; preserve current focus after inline edits&lt;br&gt;Announcement: Order review loaded&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7A5AF8;strokeWidth=1.5;fontColor=#101828;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1" arch-id="ui-screen-order-entry.ui-state-default" arch-kind="ui-state"><mxGeometry as="geometry" x="42" y="105" width="746" height="150" /></mxCell><mxCell id="ui-order-entry-state-map-state-ui-state-loading" value="&lt;b&gt;Loading order&lt;/b&gt; &lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;(loading)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#475467&quot;&gt;Trigger: Order query is pending with no usable cached result&lt;/span&gt;&lt;br&gt;Loading the order summary; controls are not exposed until labels and values are available.&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#175CD3&quot;&gt;Actions: None&lt;br&gt;Focus: Keep focus on the initiating navigation target&lt;br&gt;Announcement: Loading order review&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7A5AF8;strokeWidth=1.5;fontColor=#101828;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1" arch-id="ui-screen-order-entry.ui-state-loading" arch-kind="ui-state"><mxGeometry as="geometry" x="812" y="105" width="746" height="150" /></mxCell><mxCell id="ui-order-entry-state-map-state-ui-state-empty" value="&lt;b&gt;Empty cart&lt;/b&gt; &lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;(empty)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#475467&quot;&gt;Trigger: The order contains no purchasable items&lt;/span&gt;&lt;br&gt;Your cart is empty. Add an item before checkout.&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#175CD3&quot;&gt;Actions: ui-action-orders&lt;br&gt;Focus: Empty-state heading&lt;br&gt;Announcement: Cart is empty&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7A5AF8;strokeWidth=1.5;fontColor=#101828;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1" arch-id="ui-screen-order-entry.ui-state-empty" arch-kind="ui-state"><mxGeometry as="geometry" x="42" y="279" width="746" height="150" /></mxCell><mxCell id="ui-order-entry-state-map-state-ui-state-error" value="&lt;b&gt;Submission failed safely&lt;/b&gt; &lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;(error)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#475467&quot;&gt;Trigger: Validation, timeout, or service failure prevents confirmed submission&lt;/span&gt;&lt;br&gt;The order was not confirmed. Your information is preserved; retry uses the same checkout key.&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#175CD3&quot;&gt;Actions: ui-action-retry-order, ui-action-orders&lt;br&gt;Focus: Error summary linked to affected fields&lt;br&gt;Announcement: Order was not submitted; review the error and retry&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7A5AF8;strokeWidth=1.5;fontColor=#101828;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1" arch-id="ui-screen-order-entry.ui-state-error" arch-kind="ui-state"><mxGeometry as="geometry" x="812" y="279" width="746" height="150" /></mxCell><mxCell id="ui-order-entry-state-map-state-ui-state-success" value="&lt;b&gt;Order confirmed&lt;/b&gt; &lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;(success)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#475467&quot;&gt;Trigger: The API returns the durable order ID&lt;/span&gt;&lt;br&gt;Order confirmed. The order ID and next fulfillment step are available.&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#175CD3&quot;&gt;Actions: ui-action-orders&lt;br&gt;Focus: Confirmation heading&lt;br&gt;Announcement: Order confirmed&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7A5AF8;strokeWidth=1.5;fontColor=#101828;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1" arch-id="ui-screen-order-entry.ui-state-success" arch-kind="ui-state"><mxGeometry as="geometry" x="42" y="453" width="746" height="150" /></mxCell><mxCell id="ui-order-entry-state-map-state-ui-state-permission" value="&lt;b&gt;Permission denied&lt;/b&gt; &lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;(permission-denied)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#475467&quot;&gt;Trigger: The session is missing, expired, or lacks the customer role&lt;/span&gt;&lt;br&gt;Sign in again to review this order. No order details are disclosed.&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#175CD3&quot;&gt;Actions: None&lt;br&gt;Focus: Permission heading&lt;br&gt;Announcement: You are not authorized to review this order&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7A5AF8;strokeWidth=1.5;fontColor=#101828;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1" arch-id="ui-screen-order-entry.ui-state-permission" arch-kind="ui-state"><mxGeometry as="geometry" x="812" y="453" width="746" height="150" /></mxCell><mxCell id="ui-order-entry-state-map-state-ui-state-offline" value="&lt;b&gt;Offline&lt;/b&gt; &lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;(offline)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#475467&quot;&gt;Trigger: Connectivity is unavailable before confirmation&lt;/span&gt;&lt;br&gt;You appear to be offline. Your entered information remains local to this checkout session.&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#175CD3&quot;&gt;Actions: ui-action-retry-order&lt;br&gt;Focus: Offline status message&lt;br&gt;Announcement: Offline; order has not been submitted&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#7A5AF8;strokeWidth=1.5;fontColor=#101828;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1" arch-id="ui-screen-order-entry.ui-state-offline" arch-kind="ui-state"><mxGeometry as="geometry" x="42" y="627" width="746" height="150" /></mxCell><mxCell id="ui-order-entry-state-map-legend-box" value="&lt;b&gt;Legend&lt;/b&gt;" style="swimlane;html=1;rounded=1;horizontal=1;startSize=28;collapsible=0;container=0;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#98A2B3;fontColor=#344054;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" parent="1" vertex="1" arch-id="ui-order-entry-state-map-legend" arch-kind="legend"><mxGeometry as="geometry" x="1280" y="860" width="310" height="90" /></mxCell><mxCell id="ui-order-entry-state-map-legend-item-0" value="&lt;b&gt;State card&lt;/b&gt; &lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;— Trigger, content, actions, focus, and announcement&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#344054;fontSize=9;spacingLeft=20;indicatorColor=#7A5AF8;indicatorShape=rect;" parent="1" vertex="1"><mxGeometry as="geometry" x="1288" y="891" width="294" height="23" /></mxCell><mxCell id="ui-order-entry-state-map-legend-item-1" value="&lt;b&gt;No motion&lt;/b&gt; &lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;— All transitions are static by contract&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#344054;fontSize=9;spacingLeft=20;indicatorColor=#667085;indicatorShape=rect;" parent="1" vertex="1"><mxGeometry as="geometry" x="1288" y="916" width="294" height="23" /></mxCell></root></mxGraphModel></diagram></mxfile>