nt="1" vertex="1"><mxGeometry as="geometry" x="128" y="981" width="294" height="23" /></mxCell><mxCell id="resilience-recovery-legend-item-7" value="&lt;b&gt;Batch flow&lt;/b&gt; &lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;— Connection mode&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#344054;fontSize=9;spacingLeft=20;indicatorColor=#7C3AED;indicatorShape=rect;" parent="1" vertex="1"><mxGeometry as="geometry" x="128" y="1006" width="294" height="23" /></mxCell><mxCell id="resilience-recovery-legend-item-8" value="&lt;b&gt;Async flow&lt;/b&gt; &lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;— Connection mode&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#344054;fontSize=9;spacingLeft=20;indicatorColor=#EA580C;indicatorShape=rect;" parent="1" vertex="1"><mxGeometry as="geometry" x="128" y="1031" width="294" height="23" /></mxCell><mxCell id="resilience-recovery-legend-item-9" value="&lt;b&gt;Stream flow&lt;/b&gt; &lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;— Connection mode&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#344054;fontSize=9;spacingLeft=20;indicatorColor=#0F766E;indicatorShape=rect;" parent="1" vertex="1"><mxGeometry as="geometry" x="128" y="1056" width="294" height="23" /></mxCell></root></mxGraphModel></diagram><diagram id="0bcb3313d621" name="Customer order submission user flow"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ui-customer-order-flow-title" value="&lt;b&gt;Customer order submission user flow&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=20;fontColor=#101828;fontStyle=1;" parent="1" vertex="1" arch-id="ui-customer-order-flow" arch-kind="view-title"><mxGeometry as="geometry" x="24" y="16" width="1452" height="34" /></mxCell><mxCell id="ui-customer-order-flow-purpose" value="Review the customer goal, screen actions, observable outcomes, and retry-safe exception path." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#475467;" parent="1" vertex="1"><mxGeometry as="geometry" x="24" y="50" width="1452" height="28" /></mxCell><mxCell id="ui-customer-order-flow-flow-persona" value="&lt;b&gt;Authenticated retail customer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#475467&quot;&gt;Goal: Submit one valid order and receive a durable confirmation without duplicate creation.&lt;/span&gt;" style="shape=mxgraph.basic.person;html=1;whiteSpace=wrap;fillColor=#E8F0FE;strokeColor=#4F6BED;fontColor=#172B4D;fontSize=11;verticalLabelPosition=bottom;verticalAlign=top;align=center;" parent="1" vertex="1" arch-id="ui-persona-retail-customer" arch-kind="ui-persona"><mxGeometry as="geometry" x="52" y="115" width="130" height="110" /></mxCell><mxCell id="ui-customer-order-flow-flow-step-ui-step-review-order" value="&lt;b&gt;1. reviews items, quantities, totals, and delivery information&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#175CD3&quot;&gt;Review and submit order · /checkout/review&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#475467&quot;&gt;Outcome: The complete order summary and editable fields are available in logical reading order.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#B54708&quot;&gt;Exception: Unavailable items are identified inline and submission remains disabled until resolved.&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2E90FA;strokeWidth=1.5;fontColor=#101828;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1" arch-id="ui-flow-submit-order.ui-step-review-order" arch-kind="ui-flow-step"><mxGeometry as="geometry" x="245" y="105" width="430" height="106" /></mxCell><mxCell id="ui-customer-order-flow-flow-edge-1" value="Start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontColor=#475467;fontSize=9;" parent="1" edge="1" source="ui-customer-order-flow-flow-persona" target="ui-customer-order-flow-flow-step-ui-step-review-order"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="ui-customer-order-flow-flow-step-ui-step-submit-order" value="&lt;b&gt;2. activates Submit order once&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#175CD3&quot;&gt;Review and submit order · /checkout/review&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#475467&quot;&gt;Outcome: The action is disabled, the same idempotency key is sent, progress is announced, and duplicate activation is prevented.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#B54708&quot;&gt;Exception: A network or service error preserves entered data and offers a retry with the same key.&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2E90FA;strokeWidth=1.5;fontColor=#101828;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1" arch-id="ui-flow-submit-order.ui-step-submit-order" arch-kind="ui-flow-step"><mxGeometry as="geometry" x="245" y="245" width="430" height="106" /></mxCell><mxCell id="ui-customer-order-flow-flow-edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontColor=#475467;fontSize=9;" parent="1" edge="1" source="ui-customer-order-flow-flow-step-ui-step-review-order" target="ui-customer-order-flow-flow-step-ui-step-submit-order"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="ui-customer-order-flow-flow-step-ui-step-confirm-order" value="&lt;b&gt;3. reviews the confirmed order ID&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#175CD3&quot;&gt;Review and submit order · /checkout/review&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#475467&quot;&gt;Outcome: A durable confirmation, next step, and navigation to orders are available and announced.&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2E90FA;strokeWidth=1.5;fontColor=#101828;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1" arch-id="ui-flow-submit-order.ui-step-confirm-order" arch-kind="ui-flow-step"><mxGeometry as="geometry" x="245" y="385" width="430" height="106" /></mxCell><mxCell id="ui-customer-order-flow-flow-edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontColor=#475467;fontSize=9;" parent="1" edge="1" source="ui-customer-order-flow-flow-step-ui-step-submit-order" target="ui-customer-order-flow-flow-step-ui-step-confirm-order"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="ui-customer-order-flow-flow-summary" value="&lt;b&gt;Success outcomes&lt;/b&gt;&lt;br&gt;• Exactly one order is created&lt;br&gt;• The customer receives an order ID&lt;br&gt;• Submission status is understandable without motion or color alone&lt;br&gt;&lt;br&gt;&lt;b&gt;Exception paths&lt;/b&gt;&lt;br&gt;• Validation error&lt;br&gt;• Permission or session failure&lt;br&gt;• Offline or timeout&lt;br&gt;• Backend rejection with retry-safe correlation ID" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#F0FDF4;strokeColor=#12B76A;fontColor=#05603A;fontSize=10;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1" arch-id="ui-flow-submit-order" arch-kind="ui-flow"><mxGeometry as="geometry" x="730" y="105" width="735" height="230" /></mxCell><mxCell id="ui-customer-order-flow-legend-box" value="&lt;b&gt;Legend&lt;/b&gt;" style="swimlane;html=1;rounded=1;horizontal=1;startSize=28;collapsible=0;container=0;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#98A2B3;fontColor=#344054;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" parent="1" vertex="1" arch-id="ui-customer-order-flow-legend" arch-kind="legend"><mxGeometry as="geometry" x="1180" y="720" width="310" height="115" /></mxCell><mxCell id="ui-customer-order-flow-legend-item-0" value="&lt;b&gt;Persona&lt;/b&gt; &lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;— User or role pursuing the goal&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#344054;fontSize=9;spacingLeft=20;indicatorColor=#4F6BED;indicatorShape=rect;" parent="1" vertex="1"><mxGeometry as="geometry" x="1188" y="751" width="294" height="23" /></mxCell><mxCell id="ui-customer-order-flow-legend-item-1" value="&lt;b&gt;Step&lt;/b&gt; &lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;— Action on a named screen with observable outcome&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#344054;fontSize=9;spacingLeft=20;indicatorColor=#2E90FA;indicatorShape=rect;" parent="1" vertex="1"><mxGeometry as="geometry" x="1188" y="776" width="294" height="23" /></mxCell><mxCell id="ui-customer-order-flow-legend-item-2" value="&lt;b&gt;Exception&lt;/b&gt; &lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;— Alternate or failure path&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#344054;fontSize=9;spacingLeft=20;indicatorColor=#B54708;indicatorShape=rect;" parent="1" vertex="1"><mxGeometry as="geometry" x="1188" y="801" width="294" height="23" /></mxCell></root></mxGraphModel></diagram><diagram id="a7569ae10c99" name="Order entry · compact responsive wireframe"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ui-order-entry-compact-view-title" value="&lt;b&gt;Order entry · compact responsive wireframe&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=20;fontColor=#101828;fontStyle=1;" parent="1" vertex="1" arch-id="ui-order-entry-compact-view" arch-kind="view-title"><mxGeometry as="geometry" x="24" y="16" width="1552" height="34" /></mxCell><mxCell id="ui-order-entry-compact-view-purpose" value="Review compact information hierarchy, component reuse, actions, bindings, and the default state." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#475467;" parent="1" vertex="1"><mxGeometry as="geometry" x="24" y="50" width="1552" height="28" /></mxCell><mxCell id="ui-order-entry-compact-view-ui-frame" value="" style="rounded=1;arcSize=10;html=1;fillColor=#FFFFFF;strokeColor=#667085;strokeWidth=2;shadow=0;" parent="1" vertex="1" arch-id="ui-screen-order-entry" arch-kind="ui-screen"><mxGeometry as="geometry" x="42" y="108" width="355.81" height="804" /></mxCell><mxCell id="ui-order-entry-compact-view-ui-chrome" value="●  ●  ●&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;/checkout/review&lt;/b&gt;&amp;nbsp;&amp;nbsp; · &amp;nbsp;ui-compact" style="rounded=1;arcSize=10;html=1;fillColor=#F2F4F7;strokeColor=#667085;strokeWidth=1;align=left;verticalAlign=middle;fontColor=#475467;fontSize=10;spacingLeft=10;" parent="1" vertex="1"><mxGeometry as="geometry" x="42" y="108" width="355.81" height="34" /></mxCell><mxCell id="ui-order-entry-compact-view-ui-region-ui-region-header" value="&lt;b&gt;Checkout header&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;Checkout page header · banner&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#475467&quot;&gt;Page title, checkout step, and a safe route to the customer order list.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#175CD3&quot;&gt;Actions: View orders&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;shadow=0;align=left;verticalAlign=top;spacing=8;fillColor=#F4F3FF;strokeColor=#7A5AF8;strokeWidth=1.5;fontColor=#101828;fontSize=11;" parent="1" vertex="1" arch-id="ui-screen-order-entry.ui-region-header" arch-kind="ui-region"><mxGeometry as="geometry" x="42" y="142" width="355.81" height="58.39" /></mxCell><mxCell id="ui-order-entry-compact-view-ui-region-ui-region-summary" value="&lt;b&gt;Order summary&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;Order summary · complementary&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#475467&quot;&gt;Items, quantities, price breakdown, fulfillment method, and masked customer context.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#B54708&quot;&gt;Bindings: ui-binding-submit-order&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;shadow=0;align=left;verticalAlign=top;spacing=8;fillColor=#F4F3FF;strokeColor=#7A5AF8;strokeWidth=1.5;fontColor=#101828;fontSize=11;" parent="1" vertex="1" arch-id="ui-screen-order-entry.ui-region-summary" arch-kind="ui-region"><mxGeometry as="geometry" x="56.6" y="214.99" width="326.61" height="109.48" /></mxCell><mxCell id="ui-order-entry-compact-view-ui-region-ui-region-form" value="&lt;b&gt;Order review form&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;Order review form · main&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#475467&quot;&gt;Editable delivery details, validation summary, terms acknowledgement, and the primary submit action.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#175CD3&quot;&gt;Actions: Submit order&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#B54708&quot;&gt;Bindings: ui-binding-submit-order&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;shadow=0;align=left;verticalAlign=top;spacing=8;fillColor=#EFF8FF;strokeColor=#2E90FA;strokeWidth=1.5;fontColor=#101828;fontSize=11;" parent="1" vertex="1" arch-id="ui-screen-order-entry.ui-region-form" arch-kind="ui-region"><mxGeometry as="geometry" x="56.6" y="339.06" width="326.61" height="383.18" /></mxCell><mxCell id="ui-order-entry-compact-view-ui-region-ui-region-status" value="&lt;b&gt;Submission status&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;Order status panel · status&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#475467&quot;&gt;Loading, error, offline, or confirmation content with owned recovery actions and live announcements.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#175CD3&quot;&gt;Actions: Retry submission&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#B54708&quot;&gt;Bindings: ui-binding-submit-order&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;shadow=0;align=left;verticalAlign=top;spacing=8;fillColor=#ECFDF3;strokeColor=#12B76A;strokeWidth=1.5;fontColor=#101828;fontSize=11;" parent="1" vertex="1" arch-id="ui-screen-order-entry.ui-region-status" arch-kind="ui-region"><mxGeometry as="geometry" x="56.6" y="736.83" width="326.61" height="136.85" /></mxCell><mxCell id="ui-order-entry-compact-view-ui-state" value="&lt;b&gt;Rendered state · Ready to review&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;default · trigger: Order data and authorization are available&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#475467&quot;&gt;Review order details and submit when the summary is correct.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#175CD3&quot;&gt;Focus: Page heading on initial navigation; preserve current focus after inline edits · Announces: Order review loaded&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFFAEB;strokeColor=#F79009;fontColor=#7A2E0E;fontSize=10;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1" arch-id="ui-screen-order-entry.ui-state-default" arch-kind="ui-state"><mxGeometry as="geometry" x="1260" y="108" width="310" height="128" /></mxCell><mxCell id="ui-order-entry-compact-view-legend-box" value="&lt;b&gt;Legend&lt;/b&gt;" style="swimlane;html=1;rounded=1;horizontal=1;startSize=28;collapsible=0;container=0;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#98A2B3;fontColor=#344054;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" parent="1" vertex="1" arch-id="ui-order-entry-compact-view-legend" arch-kind="legend"><mxGeometry as="geometry" x="1260" y="750" width="310" height="140" /></mxCell><mxCell id="ui-order-entry-compact-view-legend-item-0" value="&lt;b&gt;Blue region&lt;/b&gt; &lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;— Primary content or data-bound surface&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#344054;fontSize=9;spacingLeft=20;indicatorColor=#2E90FA;indicatorShape=rect;" parent="1" vertex="1"><mxGeometry as="geometry" x="1268" y="781" width="294" height="23" /></mxCell><mxCell id="ui-order-entry-compact-view-legend-item-1" value="&lt;b&gt;Green region&lt;/b&gt; &lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;— Interactive action surface&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#344054;fontSize=9;spacingLeft=20;indicatorColor=#12B76A;indicatorShape=rect;" parent="1" vertex="1"><mxGeometry as="geometry" x="1268" y="806" width="294" height="23" /></mxCell><mxCell id="ui-order-entry-compact-view-legend-item-2" value="&lt;b&gt;Purple region&lt;/b&gt; &lt;span style=&quot;font-size:9px;color:#667085&quot;&gt;— Navigation or supporting l