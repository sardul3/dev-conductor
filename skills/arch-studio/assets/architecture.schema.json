{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/arch-studio/architecture.schema.json",
  "title": "Arch Studio canonical architecture and UI model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "requirements",
    "platform",
    "controls",
    "components",
    "relationships",
    "views",
    "decisions",
    "risks",
    "assumptions",
    "open_questions",
    "waivers"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project": {"$ref": "#/$defs/project"},
    "requirements": {
      "type": "array",
      "items": {"$ref": "#/$defs/requirement"}
    },
    "platform": {"$ref": "#/$defs/platform"},
    "controls": {
      "type": "array",
      "items": {"$ref": "#/$defs/control"}
    },
    "components": {
      "type": "array",
      "items": {"$ref": "#/$defs/component"}
    },
    "relationships": {
      "type": "array",
      "items": {"$ref": "#/$defs/relationship"}
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/view"}
    },
    "ui_spec": {"$ref": "#/$defs/uiSpec"},
    "decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/decision"}
    },
    "risks": {
      "type": "array",
      "items": {"$ref": "#/$defs/risk"}
    },
    "assumptions": {
      "type": "array",
      "items": {"$ref": "#/$defs/assumption"}
    },
    "open_questions": {
      "type": "array",
      "items": {"$ref": "#/$defs/openQuestion"}
    },
    "waivers": {
      "type": "array",
      "items": {"$ref": "#/$defs/waiver"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 80
    },
    "stringArray": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "idArray": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "confidence", "note"],
      "properties": {
        "source": {
          "enum": ["repository", "document", "user", "runtime", "inference", "proposal"]
        },
        "reference": {"type": "string"},
        "commit": {"type": "string"},
        "confidence": {"enum": ["high", "medium", "low"]},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "version", "status", "description", "cloud_provider",
        "environments", "primary_region", "secondary_region", "owners",
        "data_residency", "classification", "reviewed_at"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 3},
        "version": {"type": "string", "minLength": 1},
        "status": {"enum": ["draft", "in-review", "approved", "implemented", "retired"]},
        "description": {"type": "string", "minLength": 1},
        "cloud_provider": {"type": "string", "minLength": 2},
        "environments": {"$ref": "#/$defs/stringArray"},
        "primary_region": {"type": "string", "minLength": 1},
        "secondary_region": {"type": ["string", "null"]},
        "owners": {"$ref": "#/$defs/stringArray"},
        "data_residency": {"type": "string", "minLength": 1},
        "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
        "reviewed_at": {"type": "string"},
        "source_commit": {"type": "string"}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "text", "priority", "status", "owner", "acceptance", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["functional", "availability", "performance", "scalability", "security", "compliance", "data", "operations", "cost", "constraint"]},
        "text": {"type": "string", "minLength": 3},
        "priority": {"enum": ["must", "should", "could"]},
        "status": {"enum": ["confirmed", "evidenced", "assumed", "unresolved", "non-applicable"]},
        "owner": {"type": "string", "minLength": 1},
        "acceptance": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["azure", "kubernetes", "delivery", "operations"],
      "properties": {
        "azure": {"type": "object", "additionalProperties": true},
        "kubernetes": {"type": "object", "additionalProperties": true},
        "delivery": {"type": "object", "additionalProperties": true},
        "operations": {"type": "object", "additionalProperties": true}
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "domain", "description", "implementation", "owner", "status", "requirements", "risks", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 2},
        "domain": {"type": "string", "minLength": 2},
        "description": {"type": "string", "minLength": 2},
        "implementation": {"type": "string", "minLength": 2},
        "owner": {"type": "string", "minLength": 1},
        "status": {"enum": ["proposed", "planned", "implemented", "verified", "non-applicable"]},
        "requirements": {"$ref": "#/$defs/idArray"},
        "risks": {"$ref": "#/$defs/idArray"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "kind", "description", "technology", "owner", "criticality",
        "data_classification", "lifecycle", "public_exposure", "requirements", "controls", "evidence"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 2},
        "kind": {
          "enum": ["actor", "external-system", "client", "gateway", "service", "function", "worker", "message-broker", "database", "cache", "storage", "identity", "security", "observability", "pipeline", "repository", "kubernetes", "network", "generic"]
        },
        "description": {"type": "string", "minLength": 3},
        "technology": {"type": "string", "minLength": 1},
        "azure_service": {"type": "string"},
        "owner": {"type": "string", "minLength": 1},
        "criticality": {"enum": ["low", "medium", "high", "mission-critical"]},
        "data_classification": {"enum": ["none", "public", "internal", "confidential", "restricted"]},
        "lifecycle": {"enum": ["existing", "new", "changed", "retiring", "external"]},
        "public_exposure": {"enum": ["none", "private", "public", "unknown"]},
        "region": {"type": "string"},
        "resource_group": {"type": "string"},
        "namespace": {"type": "string"},
        "sku": {"type": "string"},
        "scaling": {"type": "string"},
        "persistence": {"type": "string"},
        "requirements": {"$ref": "#/$defs/idArray"},
        "controls": {"$ref": "#/$defs/idArray"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "label", "direction", "protocol", "port", "auth", "mode", "encrypted", "data", "failure_behavior", "requirements", "controls", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "from": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 3},
        "direction": {"enum": ["forward", "bidirectional"]},
        "protocol": {"type": "string", "minLength": 1},
        "port": {"type": ["string", "integer", "null"]},
        "auth": {"type": "string", "minLength": 1},
        "mode": {"enum": ["sync", "async", "batch", "stream"]},
        "encrypted": {"type": "boolean"},
        "data": {"$ref": "#/$defs/stringArray"},
        "timeout": {"type": "string"},
        "retry": {"type": "string"},
        "idempotency": {"type": "string"},
        "ordering": {"type": "string"},
        "failure_behavior": {"type": "string", "minLength": 2},
        "requirements": {"$ref": "#/$defs/idArray"},
        "controls": {"$ref": "#/$defs/idArray"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "x", "y", "w", "h"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "kind": {"enum": ["system", "trust", "cloud", "tenant", "management-group", "subscription", "region", "resource-group", "vnet", "subnet", "cluster", "namespace", "data-residency", "failure-domain", "generic"]},
        "x": {"type": "number", "minimum": 0},
        "y": {"type": "number", "minimum": 0},
        "w": {"type": "number", "minimum": 120},
        "h": {"type": "number", "minimum": 100},
        "parent": {"$ref": "#/$defs/id"},
        "description": {"type": "string"}
      }
    },
    "nodePlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "x", "y", "w", "h"],
      "properties": {
        "component": {"$ref": "#/$defs/id"},
        "x": {"type": "number", "minimum": 0},
        "y": {"type": "number", "minimum": 0},
        "w": {"type": "number", "minimum": 80},
        "h": {"type": "number", "minimum": 50},
        "boundary": {"$ref": "#/$defs/id"},
        "note": {"type": "string"}
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "label", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "from": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 2},
        "kind": {"enum": ["sync", "async", "return"]},
        "note": {"type": "string"}
      }
    },
    "legend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["auto", "authored", "hidden"]},
        "x": {"type": "number", "minimum": 0},
        "y": {"type": "number", "minimum": 0},
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "description"],
            "properties": {
              "label": {"type": "string"},
              "description": {"type": "string"},
              "color": {"type": "string"}
            }
          }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "purpose", "width", "height", "nodes", "legend", "requirements", "decisions"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 2},
        "type": {"enum": ["system-context", "container", "component", "deployment", "network", "security", "data-flow", "sequence", "kubernetes", "ci-cd", "observability", "resilience", "migration", "lifecycle", "executive", "user-flow", "ui-wireframe", "ui-state-map", "generic"]},
        "purpose": {"type": "string", "minLength": 3},
        "width": {"type": "number", "minimum": 640},
        "height": {"type": "number", "minimum": 480},
        "boundaries": {"type": "array", "items": {"$ref": "#/$defs/boundary"}},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/nodePlacement"}},
        "edges": {"$ref": "#/$defs/idArray"},
        "participants": {"$ref": "#/$defs/idArray"},
        "interactions": {"type": "array", "items": {"$ref": "#/$defs/interaction"}},
        "screen": {"$ref": "#/$defs/id"},
        "flow": {"$ref": "#/$defs/id"},
        "breakpoint": {"$ref": "#/$defs/id"},
        "state": {"$ref": "#/$defs/id"},
        "legend": {"$ref": "#/$defs/legend"},
        "requirements": {"$ref": "#/$defs/idArray"},
        "decisions": {"$ref": "#/$defs/idArray"}
      }
    },
    "uiSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "platforms", "design_system", "personas", "breakpoints", "flows", "screens", "components", "bindings", "navigation", "accessibility", "implementation", "analytics"],
      "properties": {
        "status": {"enum": ["not-requested", "draft", "in-review", "approved", "implemented"]},
        "platforms": {"$ref": "#/$defs/stringArray"},
        "design_system": {"$ref": "#/$defs/uiDesignSystem"},
        "personas": {"type": "array", "items": {"$ref": "#/$defs/uiPersona"}},
        "breakpoints": {"type": "array", "items": {"$ref": "#/$defs/uiBreakpoint"}},
        "flows": {"type": "array", "items": {"$ref": "#/$defs/uiFlow"}},
        "screens": {"type": "array", "items": {"$ref": "#/$defs/uiScreen"}},
        "components": {"type": "array", "items": {"$ref": "#/$defs/uiComponent"}},
        "bindings": {"type": "array", "items": {"$ref": "#/$defs/uiBinding"}},
        "navigation": {"type": "array", "items": {"$ref": "#/$defs/uiNavigation"}},
        "accessibility": {"$ref": "#/$defs/uiAccessibility"},
        "implementation": {"$ref": "#/$defs/uiImplementation"},
        "analytics": {"type": "array", "items": {"$ref": "#/$defs/uiAnalytics"}}
      }
    },
    "uiDesignSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "reuse_policy", "tokens"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "reuse_policy": {"type": "string", "minLength": 1},
        "tokens": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}}
      }
    },
    "uiPersona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "goals", "roles", "access_needs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "goals": {"$ref": "#/$defs/stringArray"},
        "roles": {"$ref": "#/$defs/stringArray"},
        "access_needs": {"$ref": "#/$defs/stringArray"}
      }
    },
    "uiBreakpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "min_width", "max_width", "columns", "gutter"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "min_width": {"type": "integer", "minimum": 0},
        "max_width": {"type": ["integer", "null"], "minimum": 1},
        "columns": {"type": "integer", "minimum": 1},
        "gutter": {"type": "integer", "minimum": 0}
      }
    },
    "uiFlowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "screen", "action", "outcome"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "screen": {"$ref": "#/$defs/id"},
        "action": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "minLength": 1},
        "alternate": {"type": "string"}
      }
    },
    "uiFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "actor", "goal", "entry_screens", "preconditions", "steps", "outcomes", "exceptions", "requirements"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "actor": {"$ref": "#/$defs/id"},
        "goal": {"type": "string", "minLength": 1},
        "entry_screens": {"$ref": "#/$defs/idArray"},
        "preconditions": {"$ref": "#/$defs/stringArray"},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/uiFlowStep"}},
        "outcomes": {"$ref": "#/$defs/stringArray"},
        "exceptions": {"$ref": "#/$defs/stringArray"},
        "requirements": {"$ref": "#/$defs/idArray"}
      }
    },
    "uiState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "trigger", "content", "available_actions", "focus_target", "announcement"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["default", "loading", "empty", "error", "success", "permission-denied", "offline", "degraded", "destructive-confirmation"]},
        "trigger": {"type": "string", "minLength": 1},
        "content": {"type": "string", "minLength": 1},
        "available_actions": {"$ref": "#/$defs/idArray"},
        "focus_target": {"type": "string", "minLength": 1},
        "announcement": {"type": "string", "minLength": 1}
      }
    },
    "uiAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "permission", "keyboard"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "kind": {"enum": ["primary", "secondary", "tertiary", "link", "destructive", "navigation"]},
        "permission": {"type": "string", "minLength": 1},
        "keyboard": {"type": "string", "minLength": 1},
        "target_screen": {"$ref": "#/$defs/id"},
        "target_route": {"type": "string", "minLength": 1},
        "binding": {"$ref": "#/$defs/id"},
        "confirmation": {"type": "string"}
      }
    },
    "uiRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "component", "role", "description", "order", "visible_when", "actions", "bindings"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "component": {"$ref": "#/$defs/id"},
        "role": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 0},
        "visible_when": {"type": "string", "minLength": 1},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/uiAction"}},
        "bindings": {"$ref": "#/$defs/idArray"}
      }
    },
    "uiRegionPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "x", "y", "w", "h"],
      "properties": {
        "region": {"$ref": "#/$defs/id"},
        "x": {"type": "number", "minimum": 0},
        "y": {"type": "number", "minimum": 0},
        "w": {"type": "number", "minimum": 40},
        "h": {"type": "number", "minimum": 24}
      }
    },
    "uiLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["breakpoint", "width", "height", "placements"],
      "properties": {
        "breakpoint": {"$ref": "#/$defs/id"},
        "width": {"type": "number", "minimum": 240},
        "height": {"type": "number", "minimum": 320},
        "placements": {"type": "array", "items": {"$ref": "#/$defs/uiRegionPlacement"}}
      }
    },
    "uiScreen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "route", "purpose", "roles", "data_classification", "requirements", "flows", "states", "regions", "layouts", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "route": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "roles": {"$ref": "#/$defs/stringArray"},
        "data_classification": {"enum": ["public", "internal", "confidential", "restricted"]},
        "requirements": {"$ref": "#/$defs/idArray"},
        "flows": {"$ref": "#/$defs/idArray"},
        "states": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/uiState"}},
        "regions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/uiRegion"}},
        "layouts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/uiLayout"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "uiComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "description", "variants", "states", "props", "events", "accessibility", "implementation", "requirements"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "variants": {"$ref": "#/$defs/stringArray"},
        "states": {"$ref": "#/$defs/stringArray"},
        "props": {"$ref": "#/$defs/stringArray"},
        "events": {"$ref": "#/$defs/stringArray"},
        "accessibility": {"type": "string", "minLength": 1},
        "implementation": {"type": "string", "minLength": 1},
        "requirements": {"$ref": "#/$defs/idArray"}
      }
    },
    "uiBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "screen", "region", "architecture_component", "operation", "transport", "request", "response", "authorization", "loading", "error", "requirements"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "screen": {"$ref": "#/$defs/id"},
        "region": {"$ref": "#/$defs/id"},
        "architecture_component": {"$ref": "#/$defs/id"},
        "relationship": {"$ref": "#/$defs/id"},
        "operation": {"type": "string", "minLength": 1},
        "transport": {"type": "string", "minLength": 1},
        "request": {"type": "string", "minLength": 1},
        "response": {"type": "string", "minLength": 1},
        "authorization": {"type": "string", "minLength": 1},
        "loading": {"type": "string", "minLength": 1},
        "error": {"type": "string", "minLength": 1},
        "requirements": {"$ref": "#/$defs/idArray"}
      }
    },
    "uiNavigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "trigger", "condition", "guard", "back_behavior", "requirements"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "from": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id"},
        "trigger": {"type": "string", "minLength": 1},
        "condition": {"type": "string", "minLength": 1},
        "guard": {"type": "string", "minLength": 1},
        "back_behavior": {"type": "string", "minLength": 1},
        "requirements": {"$ref": "#/$defs/idArray"}
      }
    },
    "uiAccessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "keyboard", "focus", "screen_reader", "contrast", "zoom_reflow", "reduced_motion", "testing"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "keyboard": {"type": "string", "minLength": 1},
        "focus": {"type": "string", "minLength": 1},
        "screen_reader": {"type": "string", "minLength": 1},
        "contrast": {"type": "string", "minLength": 1},
        "zoom_reflow": {"type": "string", "minLength": 1},
        "reduced_motion": {"type": "string", "minLength": 1},
        "testing": {"$ref": "#/$defs/stringArray"}
      }
    },
    "uiImplementation": {
      "type": "object",
      "additionalProperties": false,
